{
  "name": "eliminationzx/laravel-orchid-activity-log",
  "description": "Laravel Orchid Activity Log Wrapper",
  "type": "package",
  "license": "MIT",
  "authors": [
    {
      "name": "Eliminationzx",
      "email": "eliminationzx@proton.me",
      "homepage": "https://github.com/Eliminationzx",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "eliminationzx/laravel-orchid-helpers": "^3.0.5",
    "spatie/laravel-activitylog": "^4.12"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
      "psr-4": {
          "OrchidActivityLog\\": "src/"
      }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "stubs/app/"
    }
  },
  "extra": {
      "laravel": {
          "providers": [
              "OrchidActivityLog\\Providers\\FoundationServiceProvider",
              "OrchidActivityLog\\Providers\\PlatformServiceProvider"
          ]
      }
  }
}
